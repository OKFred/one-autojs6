<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oneautojs6.capture"
    android:versionCode="1"
    android:versionName="0.1.0-debug">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
    <application
        android:label="远控画面兼容"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Android 13 普通安全窗口的全局取图开关，保留设备管理禁截策略。" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FixtureActivity" android:exported="true" />
    </application>
</manifest>
