{
  "deviceId": "phone-001",
  "mqtt": {
    "qos": 1,
    "sessionExpirySeconds": 86400
  },
  "report": {
    "transport": "mqtt",
    "httpBaseUrl": "https://example.com/api/v1/admin/mobile/device",
    "requestTimeoutMs": 15000,
    "heartbeatSeconds": 60
  },
  "security": {
    "allowedScriptIds": [
      "device.apps.list",
      "app.install",
      "app.version.check",
      "app.update.store",
      "app.update.zip",
      "file.download",
      "tiktok.post",
      "client.self-update",
      "device.network.switch"
    ],
    "maxParamsBytes": 65536
  },
  "tasks": {
    "defaultTimeoutMs": 120000,
    "maxTimeoutMs": 900000,
    "queueLimit": 20,
    "resultPollIntervalMs": 500
  },
  "tiktok": {
    "expectedHandle": "your_tiktok_handle",
    "allowedMaterialRoots": [
      "/sdcard/Download/tiktok-materials",
      "/sdcard/Download",
      "/sdcard/DCIM/Camera"
    ],
    "minIntervalSeconds": 1800,
    "maxPostsPerDay": 3,
    "materialReuseSeconds": 86400,
    "captionReuseSeconds": 86400,
    "adbKeyboard": {
      "enabled": false,
      "apkSha256": ""
    },
    "networkPolicy": {
      "enabled": false,
      "allowedCountries": ["GB"],
      "requireWifi": true,
      "probeTimeoutMs": 12000
    }
  },
  "events": {
    "battery": { "enabled": true, "debounceMs": 1000 },
    "network": { "enabled": true, "debounceMs": 1000 },
    "sms": { "enabled": true, "debounceMs": 1000 },
    "notification": {
      "enabled": true,
      "debounceMs": 1000,
      "packageAllowList": [],
      "packageDenyList": []
    }
  }
}
