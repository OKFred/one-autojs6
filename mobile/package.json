{
  "name": "one-autojs6-mobile",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/client.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path'); fs.mkdirSync('dist/scripts',{recursive:true}); fs.readdirSync('src/scripts').filter(f=>f.endsWith('.js')).forEach(f=>fs.copyFileSync(path.join('src/scripts',f),path.join('dist/scripts',f)));\"",
    "start": "node dist/client.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
