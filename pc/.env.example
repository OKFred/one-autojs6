PORT=3000
MQTT_PORT=1883
PC_IP=192.168.12.240
ONE_AUTOJS6_API_TOKEN=replace_with_at_least_16_random_characters

# 可选：手机主动连接的短期 WSS。设备令牌不能复用浏览器 API Token，
# 且必须与手机 AUTOJS6_REPORT_TOKEN 一致；每个 URL 独立启用对应能力。
# DEVICE_OPS_REPORT_TOKEN=replace_with_at_least_16_random_characters
# DEVICE_OPS_WS_URL=wss://control.example.com/api/ops/ws
# REMOTE_CONTROL_RELAY_WS_URL=wss://control.example.com/api/remote/ws
# REMOTE_CONTROL_BROWSER_ORIGINS=https://studio.example.com
# REMOTE_CONTROL_ALLOW_P2P_NEGOTIATION=false
# P2P 开启时必填；第一阶段仅允许 STUN/STUNS，不接受 TURN URL 或静态凭据。
# REMOTE_CONTROL_STUN_URLS=stun:stun.cloudflare.com:3478

# PC 设备任务统一经 Node Server 下发。BASE_URL 应包含服务端 BASE_API_PATH，
# 例如 Node: http://192.168.1.10:8787/api/v1
# 或 Worker: https://api.example.com/api/v1
NODE_SERVER_BASE_URL=http://192.168.1.10:8787/api/v1
NODE_SERVER_TOKEN=replace_with_node_server_bearer_token
AUTOJS6_CLIENT_ID=phone-001
# 可选：Studio 默认 ADB 设备和仅回环 ws-scrcpy sidecar 地址。
# AUTOJS6_ADB_SERIAL=emulator-5554
# SCRCPY_ORIGIN=http://127.0.0.1:8000

# 若填入外部云端 EMQX URL，PC 端将自动将任务直接推送到云端 EMQX：
EMQX_PROTOCOL=mqtts
EMQX_USERNAME=your_username
EMQX_PASSWORD=your_password
EMQX_HOST=your_emqx_host.com
EMQX_PORT=8883
AUTOJS6_PC_MQTT_CLIENT_ID=one-autojs6-pc-main
