PORT=3000
MQTT_PORT=1883
PC_IP=192.168.12.240

# PC 设备任务统一经 Node Server 下发。BASE_URL 应包含服务端 BASE_API_PATH，
# 例如 Node: http://192.168.1.10:8787/api/v1
# 或 Worker: https://api.example.com/api/v1
NODE_SERVER_BASE_URL=http://192.168.1.10:8787/api/v1
NODE_SERVER_TOKEN=replace_with_node_server_bearer_token
AUTOJS6_CLIENT_ID=phone-001

# 若填入外部云端 EMQX URL，PC 端将自动将任务直接推送到云端 EMQX：
EMQX_PROTOCOL=mqtts
EMQX_USERNAME=your_username
EMQX_PASSWORD=your_password
EMQX_HOST=your_emqx_host.com
EMQX_PORT=8883
